# Backend environment — copy this file to ".env" and fill in values.
# Everything here is OPTIONAL: with no keys the chat still works using a
# built-in mock reply, so the app runs out of the box.
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (macOS / Linux)

# --- AI provider (pick ONE; leave both blank to use the offline mock) ---
# RECOMMENDED: Google Gemini has a FREE tier. Key in ~1 min at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL: Anthropic Claude instead (paid). Used only if GEMINI_API_KEY is blank.
# ANTHROPIC_API_KEY=

# --- CORS (production only) ---
# Comma-separated list of deployed frontend URLs allowed to call this API.
# Local dev origins (Vite :5273 / :5173) are always allowed automatically.
#   e.g. FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=
