# Frontend environment — copy to ".env.local" (Vite reads it automatically).
#
# The base URL of the backend API.
#   • Local dev: you can leave this unset — it defaults to http://127.0.0.1:8001
#   • Production: set it to your deployed backend, e.g. https://your-api.onrender.com
VITE_API_URL=http://127.0.0.1:8001
